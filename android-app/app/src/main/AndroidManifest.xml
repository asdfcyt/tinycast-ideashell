<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 快记面板的相机页（拍照 / 识别文字）；没有相机的设备仍可从相册选图 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- 设置页里的「后台同步」引导：请求加入电池优化白名单（荣耀 / MagicOS 上建议开启） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 常驻通知（Android 13+ 需要用户授权，设置里开启时才会申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 专注倒计时到点准时叫醒应用去记录；没授权时退回到系统的省电闹钟（可能晚几分钟，打开应用时也会补记） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 16+：专注中的通知申请「实时通知」（状态栏胶囊 / 荣耀灵动胶囊是否采用由系统决定） -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 分享 / 选中文字时，用来把来源应用的包名换成应用名 -->
    <queries>
        <!-- 「在闪念贝壳打开」要知道它装没装（国内版 / 国际版） -->
        <package android:name="com.roundreddot.ideashell" />
        <package android:name="com.rrd.ideaShell" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".IdeashellApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_shell"
        android:roundIcon="@mipmap/ic_launcher_shell"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ideashell"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ideashell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 轻量输入面板：磁贴、桌面快捷方式、分享、选中文字共用，不进最近任务、不抢主界面的任务栈 -->
        <activity
            android:name=".ui.capture.QuickCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Ideashell.Translucent"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter>
                <action android:name="com.carpe.ideashell.action.QUICK_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
                荣耀任意门 / 其他应用的 deeplink 入口：
                ideashell://capture?text=正文&title=标题&url=链接&source=来源&kind=todo|note|daily（都可省略，text 至少要有）
                任意门的「文字」类服务就是用这种 deeplink 拉起应用；图片走分享 Intent（见下面的「拾忆 · 图片」）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="capture"
                    android:scheme="ideashell" />
            </intent-filter>
        </activity>

        <!-- 全屏相机页：快记面板工具栏上「拍照 / 插入图片」合并后的入口（相册、快门、识别文字） -->
        <activity
            android:name=".ui.capture.CameraOcrActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Ideashell" />

        <!-- 系统分享菜单里的「拾忆 · 摘录」；荣耀任意门把拖拽的文字也是按分享 Intent 投递的，一并接住 -->
        <activity-alias
            android:name=".ShareToIdeashell"
            android:exported="true"
            android:label="@string/share_label"
            android:targetActivity=".ui.capture.QuickCaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity-alias>

        <!-- 系统分享菜单里的「拾忆 · 图片」：相册 / 截图 / 其他应用分享图片过来，保存成带图片的笔记（或 Daily Note） -->
        <activity-alias
            android:name=".ShareImageToIdeashell"
            android:exported="true"
            android:label="@string/share_image_label"
            android:targetActivity=".ui.capture.QuickCaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

        <!-- 选中文字弹出菜单里的「记到拾忆」 -->
        <activity-alias
            android:name=".ProcessTextToIdeashell"
            android:exported="true"
            android:label="@string/process_text_label"
            android:targetActivity=".ui.capture.QuickCaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面待办小部件。com.hihonor.widget.type 让荣耀识别它是应用卡片，系统会自动套用液态玻璃材质 -->
        <receiver
            android:name=".system.TodoWidgetProvider"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
            <meta-data
                android:name="com.hihonor.widget.type"
                android:value="honorcard" />
        </receiver>

        <!-- 桌面专注小部件 -->
        <receiver
            android:name=".system.FocusWidgetProvider"
            android:exported="true"
            android:label="@string/widget_focus_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
            <meta-data
                android:name="com.hihonor.widget.type"
                android:value="honorcard" />
        </receiver>

        <!-- 桌面记录时间河小部件 -->
        <receiver
            android:name=".system.RiverWidgetProvider"
            android:exported="true"
            android:label="@string/widget_river_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/river_widget_info" />
            <meta-data
                android:name="com.hihonor.widget.type"
                android:value="honorcard" />
        </receiver>

        <!-- 记录时间河小部件里可滑动的列表 -->
        <service
            android:name=".system.RiverWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 小部件 / 通知上的按钮（完成、内联回复快记、刷新），只给本应用自己的 PendingIntent 用 -->
        <receiver
            android:name=".system.TodoActionReceiver"
            android:exported="false" />

        <!-- 专注通知上的「记录」：把专注中的想法记到当前任务的任务笔记 -->
        <activity
            android:name=".ui.focus.FocusRecordActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Ideashell.Translucent"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- 专注通知上的按钮（暂停 / 继续 / 结束）与到点闹钟 -->
        <receiver
            android:name=".system.FocusActionReceiver"
            android:exported="false" />

        <!-- 快速设置磁贴 -->
        <service
            android:name=".system.QuickCaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 快速设置磁贴：专注（点一下打开专注页；专注中显示为点亮） -->
        <service
            android:name=".system.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="@string/tile_focus_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 拍照：给系统相机一个可写入的临时文件地址 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
