<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 长按桌面图标出现的快捷方式；也可以从这里拖出来放到桌面 -->
    <shortcut
        android:shortcutId="quick_note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutShortLabel="@string/shortcut_note_short"
        android:shortcutLongLabel="@string/shortcut_note_long">
        <intent
            android:action="com.carpe.ideashell.action.QUICK_CAPTURE"
            android:targetPackage="com.carpe.ideashell"
            android:targetClass="com.carpe.ideashell.ui.capture.QuickCaptureActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="voice_note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice_note_short"
        android:shortcutLongLabel="@string/shortcut_voice_note_long">
        <intent
            android:action="com.carpe.ideashell.action.QUICK_CAPTURE"
            android:targetPackage="com.carpe.ideashell"
            android:targetClass="com.carpe.ideashell.ui.capture.QuickCaptureActivity">
            <extra
                android:name="start_voice"
                android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="toggle_excerpt"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_excerpt"
        android:shortcutShortLabel="@string/shortcut_excerpt_short"
        android:shortcutLongLabel="@string/shortcut_excerpt_long">
        <intent
            android:action="com.carpe.ideashell.action.TOGGLE_EXCERPT"
            android:targetPackage="com.carpe.ideashell"
            android:targetClass="com.carpe.ideashell.ui.capture.ExcerptToggleActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="start_focus"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_focus"
        android:shortcutShortLabel="@string/shortcut_focus_short"
        android:shortcutLongLabel="@string/shortcut_focus_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.carpe.ideashell"
            android:targetClass="com.carpe.ideashell.ui.MainActivity">
            <extra
                android:name="open_focus"
                android:value="true" />
        </intent>
    </shortcut>

    <!--
        直接分享（Direct Share）：分享菜单第一行出现「拾忆 · 待办 / 日记 / 笔记 / 某个项目」。
        这些目标本身是代码里发布的动态快捷方式（见 system/DirectShare.kt），带同一个 category 就会按下面的声明接收分享。
        文字走「拾忆 · 摘录」入口，图片走「拾忆 · 图片」入口。
    -->
    <share-target android:targetClass="com.carpe.ideashell.ShareToIdeashell">
        <data android:mimeType="text/*" />
        <category android:name="com.carpe.ideashell.category.SHARE_TARGET" />
    </share-target>
    <share-target android:targetClass="com.carpe.ideashell.ShareImageToIdeashell">
        <data android:mimeType="image/*" />
        <category android:name="com.carpe.ideashell.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
