<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏展开状态：顶部是圆环 + 概览（今天 N · 逾期 M）+ 橙色的 + 记一条，下面逐行列出任务，每行左边的圆圈可直接完成 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/n_ring"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/n_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/n_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/notification_add_bg"
            android:contentDescription="@string/notification_add"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification_add" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/n_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
