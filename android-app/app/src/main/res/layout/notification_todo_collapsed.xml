<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏收起状态：左边「任务标题 + 今天 16:00」，右边内联的 > 下一项、+ 记一条（对标滴答清单） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/n_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/n_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/n_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/notification_next"
        android:scaleType="center"
        android:src="@drawable/ic_action_next"
        android:tint="?android:attr/textColorSecondary" />

    <ImageButton
        android:id="@+id/n_add"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/notification_add"
        android:scaleType="center"
        android:src="@drawable/ic_action_add"
        android:tint="?android:attr/textColorSecondary" />
</LinearLayout>
