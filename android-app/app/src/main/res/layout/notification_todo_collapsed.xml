<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏收起状态：左边小圆环（今天专注了多久，点一下进专注页），中间「任务标题 + 今天 16:00」，右边 > 下一项、橙色圆形的 + 记一条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <!-- 圆环（位图只画环弧）+ 圆心文字：文字用系统的通知文字色，通知底色深浅都看得清 -->
    <FrameLayout
        android:id="@+id/n_ring_box"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/n_ring"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/n_ring_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/n_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/n_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/n_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/notification_next"
        android:scaleType="center"
        android:src="@drawable/ic_action_next"
        android:tint="?android:attr/textColorSecondary" />

    <ImageButton
        android:id="@+id/n_add"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/notification_add_bg"
        android:contentDescription="@string/notification_add"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notification_add" />
</LinearLayout>
