<?xml version="1.0" encoding="utf-8"?>
<!-- 记录时间河的节点：竖线贯穿整行，笔记 = 橙色三角 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_horizontal|fill_vertical" android:width="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_line" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/river_triangle_orange"
        android:gravity="center"
        android:width="12dp"
        android:height="12dp" />
</layer-list>
