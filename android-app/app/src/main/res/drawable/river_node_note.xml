<?xml version="1.0" encoding="utf-8"?>
<!-- 记录时间河的节点：竖线贯穿整行，中间一个实心圆（笔记 = 橙色） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_horizontal|fill_vertical" android:width="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_line" />
        </shape>
    </item>
    <item android:gravity="center" android:width="10dp" android:height="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_chip" />
        </shape>
    </item>
</layer-list>
