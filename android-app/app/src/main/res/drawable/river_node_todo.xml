<?xml version="1.0" encoding="utf-8"?>
<!-- 记录时间河的节点：完成的待办 = 灰色方块 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_horizontal|fill_vertical" android:width="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_line" />
        </shape>
    </item>
    <item android:gravity="center" android:width="9dp" android:height="9dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_secondary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
